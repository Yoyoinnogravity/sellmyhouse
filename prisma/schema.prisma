generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  claimedProperties Property[] @relation("ClaimedProperties")
  developerClaims   DeveloperClaim[]
}

model Agent {
  id           Int        @id @default(autoincrement())
  name         String
  agency       String
  phone        String
  email        String     @unique
  country      String
  city         String?
  license      String?
  password     String?
  isAvailable  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  properties   Property[]
  representationRequests RepresentationRequest[]
  leadUnlocks  LeadUnlock[]
  agencyRecord Agency?    @relation(fields: [agencyId], references: [id])
  agencyId     Int?
}

model Agency {
  id      Int     @id @default(autoincrement())
  name    String
  country String
  website String?
  agents  Agent[]
}

model Solicitor {
  id         Int        @id @default(autoincrement())
  name       String
  firm       String
  phone      String
  email      String
  country    String
  city       String?
  license    String?
  createdAt  DateTime   @default(now())
}

model Property {
  id           Int        @id @default(autoincrement())
  title        String
  price        Int
  location     String
  contactType  String // "direct" or "agent"
  contactName  String?
  contactPhone String?
  contactEmail String?
  source       String? // "manual", "imported", "agency"
  image        String?
  currency     String?
  propertyType String?
  bedrooms     Int?
  bathrooms    Int?
  builtUp      Int?
  landSize     Int?
  tenure       String?
  images       String?
  description  String?
  metadata     String?
  agent        Agent?   @relation(fields: [agentId], references: [id])
  agentId      Int?
  solicitorId  Int?
  representationRequests RepresentationRequest[]
  claimedBy    User?    @relation("ClaimedProperties", fields: [claimedById], references: [id])
  claimedById  Int?
  claimedAt    DateTime?
  developerVerified Boolean @default(false)
  lead         Lead?
  createdAt    DateTime   @default(now())
}

// A seller who ticked "let realtors contact me". The seller's number is
// not shown publicly; agents in the same town pay a flat fee to receive it.
model Lead {
  id          Int      @id @default(autoincrement())
  property    Property @relation(fields: [propertyId], references: [id])
  propertyId  Int      @unique
  sellerName  String
  sellerPhone String
  sellerEmail String?
  city        String
  country     String
  site        String   @default("house") // which brand the seller listed on
  status      String   @default("open") // "open" | "closed"
  createdAt   DateTime @default(now())
  unlocks     LeadUnlock[]
}

// One agent asking for one seller's number. Paid by bank transfer for now;
// the admin marks it paid and the number is released.
model LeadUnlock {
  id        Int       @id @default(autoincrement())
  lead      Lead      @relation(fields: [leadId], references: [id])
  leadId    Int
  agent     Agent     @relation(fields: [agentId], references: [id])
  agentId   Int
  priceMyr  Int
  status    String    @default("requested") // "requested" | "paid" | "refused"
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@unique([leadId, agentId])
}

model DeveloperClaim {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
  company      String
  contactEmail String?
  contactPhone String?
  listingIds   String // JSON array of Property ids
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt    DateTime @default(now())
  decidedAt    DateTime?
}

model RepresentationRequest {
  id         Int      @id @default(autoincrement())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId Int
  agent      Agent    @relation(fields: [agentId], references: [id])
  agentId    Int
  createdAt  DateTime @default(now())

  @@unique([propertyId, agentId])
}
