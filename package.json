{
  "name": "sellmyhouse",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "@prisma/engines": true,
    "bcrypt": true,
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.ts",
    "db:generate": "prisma7 generate",
    "db:push": "prisma7 db push",
    "db:seed": "npm run seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.7",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^8.0.0-rc.22",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@prisma/prisma7": "^7.10.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
